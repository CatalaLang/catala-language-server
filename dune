(vendored_dirs vendors)

(env
 ; don't stop building because of warnings
 (dev
  (flags
   (:standard -warn-error -a+8 -w -67)))
 ; for CI runs: must fail on warnings
 (check
  (flags
   (:standard
    -w
    +a-4-29-40-41-42-44-45-48-58-59-60-63-64-65-66-67-68-69-70
    -warn-error
    +a)))
 ; let us see the warnings even in release mode, but non-fatal
 (release
  (flags
   (:standard
    -w
    +a-4-29-40-41-42-44-45-48-58-59-60-63-64-65-66-67-68-69-70
    -warn-error
    -a))))

; package.json is the source; only its per-language keys are generated.
; Out of date: `dune build @runtest` fails with the diff, `dune promote` fixes it.
(rule
 (target package.json.gen)
 (deps
  package.json
  (glob_files snippets/*.json))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:languages/gen_config.exe} package.json))))

(rule
 (alias runtest)
 (action
  (diff package.json package.json.gen)))
