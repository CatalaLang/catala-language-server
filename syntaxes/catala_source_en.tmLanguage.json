{
  "scopeName": "source.catala_en",
  "fileTypes": [
    "catala_en",
    "catala_en.md"
  ],
  "patterns": [
    {
      "include": "#main"
    },
    {
      "include": "text.html.markdown"
    }
  ],
  "repository": {
    "main": {
      "patterns": [
        {
          "match": "(>)\\s*(Module)\\s+(\\p{Lu}(\\p{L}|\\p{N}|[_'])*)\\s+(external)",
          "captures": {
            "1": {
              "name": "keyword.operator"
            },
            "2": {
              "name": "keyword.other"
            },
            "3": {
              "name": "entity.name.class"
            },
            "4": {
              "name": "keyword.other"
            }
          }
        },
        {
          "match": "(>)\\s*(Module|Using)\\s+(\\p{Lu}(\\p{L}|\\p{N}|[_'])*)",
          "captures": {
            "1": {
              "name": "keyword.operator"
            },
            "2": {
              "name": "keyword.other"
            },
            "3": {
              "name": "entity.name.class"
            }
          }
        },
        {
          "match": "(>)\\s*(Using)\\s+(\\p{Lu}(\\p{L}|\\p{N}|[_'])*)\\s+(as)\\s+(\\p{Lu}(\\p{L}|\\p{N}|[_'])*)",
          "captures": {
            "1": {
              "name": "keyword.operator"
            },
            "2": {
              "name": "keyword.other"
            },
            "3": {
              "name": "entity.name.class"
            },
            "4": {
              "name": "keyword.other"
            },
            "5": {
              "name": "entity.name.class"
            }
          }
        },
        {
          "match": "(>)\\s+(Include:)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "keyword.operator"
            },
            "2": {
              "name": "keyword.other"
            },
            "3": {
              "name": "markup.raw"
            }
          }
        },
        {
          "begin": "(```catala-metadata\\p{Cc}*)$",
          "beginCaptures": {
            "1": {
              "name": "comment.block.documentation"
            }
          },
          "patterns": [
            {
              "include": "code.catala_en"
            }
          ],
          "end": "(```)",
          "endCaptures": {
            "1": {
              "name": "comment.block.documentation"
            }
          }
        },
        {
          "begin": "(```catala\\p{Cc}*)$",
          "beginCaptures": {
            "1": {
              "name": "comment.block"
            }
          },
          "patterns": [
            {
              "include": "code.catala_en"
            }
          ],
          "end": "(```)",
          "endCaptures": {
            "1": {
              "name": "comment.block"
            }
          }
        }
      ]
    }
  }
}
